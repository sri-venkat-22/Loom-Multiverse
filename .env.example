# Loom API keys. Copy to `.env` and fill in the keys you use.
# Loaded by loom.config.apply_credentials at startup. Precedence:
#   already-exported env var  >  this .env  >  ~/.loom/credentials.json
# `.env` is gitignored — never commit real keys.

# Cheap tier (default eval/build model — see MODEL_TIERS["cheap"]).
NVIDIA_NIM_API_KEY=

# Strong tier (claude-sonnet-5).
ANTHROPIC_API_KEY=

# Web search tool (Shape A validate phase).
TAVILY_API_KEY=

# Optional providers — only if you point a model at them.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
GEMINI_API_KEY=
